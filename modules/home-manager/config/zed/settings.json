{
  "project_panel": {
    "folder_indicator": "chevron",
    "file_icons": true,
    "entry_spacing": "comfortable",
    "dock": "left",
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "crates.io",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "docs.rs"
      ]
    },
    "default_profile": "write",
    "default_model": {
      "provider": "openrouter",
      "model": "openrouter/auto-beta",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "which_key": {
    "delay_ms": 100,
    "enabled": true,
  },
  "ui_font_family": "DejaVu Sans Mono",
  "buffer_font_family": "DejaVu Sans Mono",
  "helix_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
}
